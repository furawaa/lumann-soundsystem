{
  "name": "lumann-soundsystem-web",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:diff && npm run test:find",
    "test:diff": "esbuild src/diff.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/diff.test.mjs --log-level=error && node node_modules/.cache/diff.test.mjs",
    "test:find": "esbuild src/find.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/find.test.mjs --log-level=error && node node_modules/.cache/find.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
